---
const wa = (numero: string, texto: string) => `https://wa.me/52${numero}?text=${encodeURIComponent(texto)}`;

const telHidrogel = '7718682542';
const hidrogelWa = (tipo?: string) =>
    wa(telHidrogel, tipo ? `Hola Celinki, quiero láminas de hidrogel ${tipo}` : 'Hola Celinki, quiero cotizar láminas de hidrogel a mayoreo');

const mapa = 'https://www.google.com/maps/dir/?api=1&destination=Plaza+Tere+Santa+Gertrudis+Hidalgo';

// Colores de etiqueta como en los empaques KASR
type Mica = { nombre: string; precio: number; nota: string; color: string; img?: string };
const celular: Mica[] = [
    { nombre: 'HD', precio: 12, nota: 'Transparente, máxima claridad', color: '#8dc63f', img: '/img/hidrogel/hd.jpg' },
    { nombre: 'Mate', precio: 12, nota: 'Antirreflejo y anti-huellas', color: '#b8893a', img: '/img/hidrogel/mate.jpg' },
    { nombre: 'Blue Ray', precio: 12, nota: 'Filtra la luz azul, cuida tus ojos', color: '#1e88e5', img: '/img/hidrogel/blue-ray.jpg' },
    { nombre: 'Privacidad Mate', precio: 28, nota: 'Nadie ve tu pantalla de lado · AG-12', color: '#1b1b1f', img: '/img/hidrogel/privacidad-mate.jpg' },
    { nombre: 'Privacidad HD', precio: 32, nota: 'Privacidad con alta definición', color: '#1b1b1f', img: '/img/hidrogel/privacidad-hd.jpg' },
    { nombre: 'Privacidad 360', precio: 55, nota: 'Privacidad por los 4 lados', color: '#c62828', img: '/img/hidrogel/privacidad-360.jpg' },
];
const tablet: Mica[] = [
    { nombre: 'Tablet 11" HD', precio: 32, nota: 'Transparente', color: '#8dc63f', img: '/img/hidrogel/tablet-11.jpg' },
    { nombre: 'Tablet 11" Mate', precio: 32, nota: 'Antirreflejo', color: '#b8893a', img: '/img/hidrogel/tablet-11.jpg' },
    { nombre: 'Tablet 13" HD', precio: 45, nota: 'Transparente, alta definición', color: '#8dc63f', img: '/img/hidrogel/tablet-13.jpg' },
    { nombre: 'Tablet 13" Mate', precio: 45, nota: 'Antirreflejo', color: '#b8893a', img: '/img/hidrogel/tablet-13-hd-mate.jpg' },
    { nombre: 'Tablet 13" Privacidad HD', precio: 95, nota: 'Privacidad con alta definición', color: '#1b1b1f', img: '/img/hidrogel/tablet-13-privacidad.svg' },
];

// Cortadoras KASR: precio del PDF de KASR + $2,500, ya como precio final
type Cortadora = { modelo: string; corte: string; ancho: number; peso: number; img: string; precio: number };
const cortadoras: Cortadora[] = [
    { modelo: 'KS-X180T', corte: '10"', ancho: 180, peso: 3.5, img: 'ks-x180t', precio: 9520 },
    { modelo: 'KS-11', corte: '12"', ancho: 196, peso: 4.3, img: 'ks-11', precio: 9610 },
    { modelo: 'KS-X5', corte: '15"', ancho: 230, peso: 6.5, img: 'ks-x5', precio: 9880 },
    { modelo: 'KS-F5 Mini', corte: '14"', ancho: 215, peso: 5.8, img: 'ks-f5-mini', precio: 10060 },
    { modelo: 'KS-230', corte: '17"', ancho: 265, peso: 5.7, img: 'ks-230', precio: 10060 },
    { modelo: 'KS-25 Mini', corte: '14"', ancho: 215, peso: 6, img: 'ks-25-mini', precio: 10240 },
    { modelo: 'KS-F5', corte: '17"', ancho: 265, peso: 6.8, img: 'ks-f5', precio: 10240 },
    { modelo: 'KS-08', corte: '14"', ancho: 213, peso: 6.9, img: 'ks-08', precio: 10330 },
    { modelo: 'KS-05', corte: '14"', ancho: 213, peso: 6.3, img: 'ks-05', precio: 10330 },
    { modelo: 'KS-01', corte: '14"', ancho: 213, peso: 6.6, img: 'ks-01', precio: 10330 },
    { modelo: 'KS-X7 Mini', corte: '14"', ancho: 215, peso: 5.6, img: 'ks-x7-mini', precio: 10330 },
    { modelo: 'KS-25', corte: '17"', ancho: 265, peso: 6.7, img: 'ks-25', precio: 10420 },
    { modelo: 'KS-F5 Max', corte: '22"', ancho: 315, peso: 7.2, img: 'ks-f5-max', precio: 10420 },
    { modelo: 'KS-X7', corte: '17"', ancho: 265, peso: 6.6, img: 'ks-x7', precio: 10510 },
    { modelo: 'KS-25 Max', corte: '22"', ancho: 315, peso: 7.6, img: 'ks-25-max', precio: 10600 },
    { modelo: 'KS-08 Max', corte: '21"', ancho: 293, peso: 7.4, img: 'ks-08-max', precio: 10690 },
    { modelo: 'KS-05 Max', corte: '21"', ancho: 293, peso: 7.9, img: 'ks-05-max', precio: 10690 },
    { modelo: 'KS-01 Max', corte: '21"', ancho: 293, peso: 7.7, img: 'ks-01-max', precio: 10690 },
    { modelo: 'KS-X7 Max', corte: '22"', ancho: 315, peso: 7.2, img: 'ks-x7-max', precio: 10690 },
];
const paquete = ['15 HD', '15 Mate', '10 Privacidad Mate', '5 Tablet 11" HD', '5 Tablet 11" Mate'];
const pesos = (n: number) => n.toLocaleString('es-MX');
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>Celinki · Hidrogel a mayoreo</title>
        <meta
            name="description"
            content="Láminas de hidrogel KASR a mayoreo para vendedores: HD, mate, Blue Ray y privacidad, para celular y tablet. Entrega gratis en Pachuca y Mineral de la Reforma desde 50 piezas. Cortadoras de hidrogel KASR con 50 láminas de regalo."
        />
        <link rel="canonical" href="https://celinki.com/" />
        <meta property="og:title" content="Celinki · Hidrogel a mayoreo" />
        <meta property="og:image" content="https://celinki.com/img/hidrogel/hd-vs-mate.jpg" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;800&display=swap" rel="stylesheet" />
    </head>
    <body>
        <main id="hidrogel" class="kasr">
            <div class="wrap">
                <div class="k-encabezado">
                    <div>
                        <p class="k-marca">CELINKI · <span>KASR</span></p>
                        <h1>Hidrogel a mayoreo</h1>
                        <p class="k-sub">Láminas de hidrogel KASR a mayoreo para vendedores y técnicos.</p>
                        <p class="k-cortado">✂ ¿No tienes cortadora? <b>Te las vendemos cortadas a tu modelo, al mismo precio.</b></p>
                        <p class="k-zonas"><b>Entrega gratis</b> en <b>Pachuca</b> y <b>Mineral de la Reforma</b> desde <b>50 piezas</b> o <b>30 de privacidad</b></p>
                        <a class="btn btn-wa" href={hidrogelWa()} target="_blank" rel="noopener">Cotizar hidrogel · 771 868 2542</a>
                    </div>
                    <img src="/img/hidrogel/hd-vs-mate.jpg" alt="Láminas de hidrogel KASR HD y mate" />
                </div>

                <h3 class="k-flechas">Celular</h3>
                <ul class="k-grid">
                    {celular.map((m) => (
                        <li class="k-card" style={`--etq:${m.color}`}>
                            <div class="k-foto">
                                {m.img ? <img src={m.img} alt={`Mica de hidrogel ${m.nombre}`} loading="lazy" /> : <span class="k-sinfoto">{m.nombre}</span>}
                            </div>
                            <div class="k-info">
                                <h4>{m.nombre}</h4>
                                <p>{m.nota}</p>
                                <p class="k-precio">${m.precio}<small> por lámina</small></p>
                                <a href={hidrogelWa(m.nombre)} target="_blank" rel="noopener">Pedir</a>
                            </div>
                        </li>
                    ))}
                </ul>

                <h3 class="k-flechas">Tablet</h3>
                <ul class="k-grid">
                    {tablet.map((m) => (
                        <li class="k-card" style={`--etq:${m.color}`}>
                            <div class="k-foto">
                                {m.img ? <img src={m.img} alt={`Mica de hidrogel ${m.nombre}`} loading="lazy" /> : <span class="k-sinfoto">{m.nombre}</span>}
                            </div>
                            <div class="k-info">
                                <h4>{m.nombre}</h4>
                                <p>{m.nota}</p>
                                <p class="k-precio">${m.precio}<small> por lámina</small></p>
                                <a href={hidrogelWa(m.nombre)} target="_blank" rel="noopener">Pedir</a>
                            </div>
                        </li>
                    ))}
                </ul>

                <h3 class="k-flechas" id="cortadoras">Cortadoras de hidrogel KASR</h3>
                <div class="k-paquete">
                    <p><b>Arma tu propio negocio de micas.</b> Cada cortadora incluye un <b>paquete inicial de 50 láminas</b>:</p>
                    <ul>{paquete.map((x) => <li>{x}</li>)}</ul>
                    <p class="k-gris">Con espátulas, tapete, cuchillas, cable y eliminador. Corta micas para celular, tablet, laptop, smartwatch, cámara, consola y más. Conexión WiFi/Bluetooth y modelos en la nube.</p>
                </div>
                <ul class="k-grid">
                    {cortadoras.map((c) => (
                        <li class="k-card" style="--etq:#8dc63f">
                            <div class="k-foto k-foto-ancha"><img src={`/img/cortadoras/${c.img}.jpg`} alt={`Cortadora de hidrogel KASR ${c.modelo}`} loading="lazy" /></div>
                            <div class="k-info">
                                <h4>{c.modelo} <span class="k-corte">Corte {c.corte}</span></h4>
                                <p>Ancho de corte {c.ancho} mm · {c.peso} kg</p>
                                <p>+ 50 láminas de regalo</p>
                                <p class="k-precio">${pesos(c.precio)}<small> precio final</small></p>
                                <a href={wa(telHidrogel, `Hola Celinki, me interesa la cortadora KASR ${c.modelo}`)} target="_blank" rel="noopener">Pedir</a>
                            </div>
                        </li>
                    ))}
                </ul>

                <h3 class="k-flechas">Cómo pedir</h3>
                <ol class="k-pasos">
                    <li><b>Mándanos tipo y cantidad</b><span>Por WhatsApp: «30 HD, 20 mate y 10 privacidad mate». ¿Las quieres cortadas? Dinos los modelos de celular, mismo precio.</span></li>
                    <li><b>Te las llevamos gratis</b><span>En Pachuca y Mineral de la Reforma desde 50 piezas, o 30 de privacidad.</span></li>
                    <li><b>O recoge en tienda</b><span>En GAMMA, Plaza Tere, Santa Gertrudis.</span></li>
                </ol>

                <h3 class="k-flechas" id="visitanos">Recoge en tienda</h3>
                <div class="k-card visita" style="--etq:#8dc63f">
                    <div class="visita-info">
                        <h4>GAMMA Accesorios para celular</h4>
                        <p class="visita-dato"><span aria-hidden="true">📍</span>Plaza Tere, A El Huixmí, 42111 Santa Gertrudis, Hgo.</p>
                        <p class="visita-dato"><span aria-hidden="true">🕐</span>Lunes a viernes, 1:00 a 5:00 pm</p>
                        <p class="visita-dato"><span aria-hidden="true">📦</span>Recoge tu pedido sin costo de envío</p>
                        <div class="visita-botones">
                            <a class="btn btn-mapa" href={mapa} target="_blank" rel="noopener">Cómo llegar</a>
                            <a class="btn btn-wa" href={hidrogelWa()} target="_blank" rel="noopener">Avisar que voy</a>
                        </div>
                    </div>
                    <iframe
                        class="visita-mapa"
                        title="Mapa de Plaza Tere, Santa Gertrudis"
                        src="https://www.google.com/maps?q=Plaza+Tere,+Santa+Gertrudis,+Hidalgo&z=16&output=embed"
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"></iframe>
                </div>
            </div>
        </main>

        <footer class="wrap">
            <p>Celinki · Hidrogel a mayoreo · WhatsApp <a href={hidrogelWa()} target="_blank" rel="noopener">771 868 2542</a></p>
        </footer>

        <a class="flotante" href={hidrogelWa()} target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp">WhatsApp</a>
    </body>
</html>

<style is:global>
    :root {
        --wa: #25d366;
        --k-fondo: #f5f6f8;
        --k-texto: #1f2328;
        --k-gris: #6b7280;
        --k-verde: #8dc63f;
    }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: Montserrat, system-ui, sans-serif; color: var(--k-texto); background: var(--k-fondo); line-height: 1.5; }
    .wrap { max-width: 1120px; margin: 0 auto; padding: 0 16px; }
    img { max-width: 100%; height: auto; display: block; }
    .btn { display: inline-block; margin-top: 12px; padding: 12px 20px; border-radius: 10px; font-weight: 800; text-decoration: none; }
    .btn-wa { background: var(--wa); color: #052e16; }

    /* ===== KASR ===== */
    .kasr { padding: 48px 0 56px; background: var(--k-fondo); }
    .k-encabezado { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 24px; align-items: center; background: #fff; border-radius: 16px; padding: 24px; border-left: 14px solid var(--k-verde); box-shadow: 0 6px 18px rgba(15, 23, 42, 0.06); }
    .k-encabezado img { border-radius: 12px; }
    .k-marca { margin: 0; font-weight: 800; letter-spacing: 0.3em; color: var(--k-verde); }
    .k-marca span { color: var(--k-texto); }
    .k-encabezado h1 { margin: 6px 0; font-family: 'Times New Roman', Georgia, serif; font-size: clamp(30px, 4.5vw, 46px); color: var(--k-verde); text-transform: uppercase; line-height: 1.05; }
    .k-sub { margin: 0 0 8px; color: var(--k-gris); }
    .k-zonas { margin: 0; }
    .k-cortado { margin: 0 0 8px; padding: 8px 12px; border-radius: 10px; background: #f4f9ec; border: 1px dashed var(--k-verde); }
    .k-flechas { display: flex; align-items: center; gap: 12px; margin: 36px 0 14px; font-size: 20px; text-transform: uppercase; letter-spacing: 0.06em; }
    .k-flechas::before { content: '«'; color: #fff; background: var(--k-verde); border-radius: 6px; padding: 0 8px; font-size: 22px; line-height: 1.3; }
    .k-grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 14px; }
    .k-card { background: #fff; border-radius: 14px; overflow: hidden; box-shadow: 0 6px 18px rgba(15, 23, 42, 0.07); border-top: 8px solid var(--etq); display: flex; flex-direction: column; }
    .k-foto { aspect-ratio: 1; background: #fff; display: grid; place-items: center; }
    .k-foto img { width: 100%; height: 100%; object-fit: contain; }
    .k-sinfoto { font-family: 'Times New Roman', Georgia, serif; font-weight: 700; font-size: 26px; text-transform: uppercase; color: var(--etq); text-align: center; padding: 16px; border: 3px solid var(--etq); border-radius: 10px; margin: 24px; }
    .k-info { padding: 12px 16px 16px; display: flex; flex-direction: column; gap: 2px; flex: 1; }
    .k-info h4 { margin: 0; font-size: 17px; }
    .k-info p { margin: 0; color: var(--k-gris); font-size: 14px; }
    .k-info .k-precio { color: var(--k-texto); font-weight: 800; font-size: 26px; margin-top: 6px; }
    .k-precio small { font-size: 13px; font-weight: 600; color: var(--k-gris); }
    .k-info a { margin-top: auto; align-self: flex-start; padding: 6px 14px; border-radius: 8px; background: var(--wa); color: #052e16; font-weight: 800; text-decoration: none; }
    .k-foto-ancha { aspect-ratio: 16 / 9; }
    .k-corte { display: inline-block; margin-left: 4px; padding: 1px 8px; border-radius: 6px; background: #1b1b1f; color: #fff; font-size: 12px; vertical-align: middle; }
    .k-paquete { background: #fff; border-radius: 14px; padding: 18px 20px; margin-bottom: 14px; border-left: 8px solid var(--k-verde); box-shadow: 0 6px 18px rgba(15, 23, 42, 0.06); }
    .k-paquete p { margin: 0 0 8px; }
    .k-paquete ul { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; padding: 0; margin: 0 0 10px; }
    .k-paquete li { border: 1px solid #dbe3c8; background: #f4f9ec; border-radius: 999px; padding: 4px 12px; font-weight: 700; }
    .k-gris { color: var(--k-gris); font-size: 14px; }
    .visita { display: grid; grid-template-columns: 1fr 1.2fr; gap: 0; }
    .visita-info { padding: 22px 24px; display: flex; flex-direction: column; gap: 10px; }
    .visita-info h4 { margin: 0 0 4px; font-size: 20px; }
    .visita-dato { margin: 0; display: flex; gap: 10px; align-items: flex-start; color: var(--k-texto); }
    .visita-dato span { width: 22px; flex: none; text-align: center; }
    .visita-botones { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 6px; }
    .visita-botones .btn { margin-top: 0; }
    .btn-mapa { background: #1b1b1f; color: #fff; }
    .visita-mapa { width: 100%; height: 100%; min-height: 260px; border: 0; display: block; }
    .k-pasos { list-style: none; counter-reset: paso; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
    .k-pasos li { counter-increment: paso; background: #fff; border-radius: 14px; padding: 18px; box-shadow: 0 6px 18px rgba(15, 23, 42, 0.06); display: flex; flex-direction: column; gap: 4px; }
    .k-pasos li::before { content: counter(paso); display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; background: var(--k-verde); color: #fff; font-weight: 800; }
    .k-pasos span { color: var(--k-gris); font-size: 14px; }

    footer { padding: 32px 16px 96px; color: var(--k-gris); }
    footer a { color: var(--k-texto); }
    .flotante { position: fixed; right: 16px; bottom: 16px; padding: 12px 18px; border-radius: 999px; background: var(--wa); color: #052e16; font-weight: 800; text-decoration: none; box-shadow: 0 4px 14px rgba(0, 0, 0, 0.2); z-index: 10; }

    @media (max-width: 860px) {
        .k-encabezado { grid-template-columns: 1fr; }
        .k-pasos { grid-template-columns: 1fr; }
        .visita { grid-template-columns: 1fr; }
    }
</style>
