---
const wa = (numero: string, texto: string) => `https://wa.me/52${numero}?text=${encodeURIComponent(texto)}`;

const telHidrogel = '7718682542';
const hidrogelWa = (tipo?: string) =>
    wa(telHidrogel, tipo ? `Hola Celinki, quiero micas de hidrogel ${tipo}` : 'Hola Celinki, quiero cotizar micas de hidrogel, cortadas al tamaño de mis modelos o en lámina sin corte');

const mapa = 'https://www.google.com/maps/dir/?api=1&destination=Plaza+Tere+Santa+Gertrudis+Hidalgo';

// Colores de etiqueta como en los empaques KASR
type Mica = { nombre: string; precio: number; nota: string; color: string; img?: string };
const celular: Mica[] = [
    { nombre: 'HD', precio: 12, nota: 'Transparente, máxima claridad', color: '#8dc63f', img: '/img/hidrogel/hd.jpg' },
    { nombre: 'Mate', precio: 12, nota: 'Antirreflejo y anti-huellas', color: '#b8893a', img: '/img/hidrogel/mate.jpg' },
    { nombre: 'Blue Ray', precio: 12, nota: 'Filtra la luz azul, cuida tus ojos', color: '#1e88e5', img: '/img/hidrogel/blue-ray.svg' },
    { nombre: 'Privacidad Mate', precio: 28, nota: 'Nadie ve tu pantalla de lado · AG-12', color: '#1b1b1f', img: '/img/hidrogel/privacidad-mate.jpg' },
    { nombre: 'Privacidad HD', precio: 32, nota: 'Privacidad con alta definición', color: '#1b1b1f', img: '/img/hidrogel/privacidad-hd.jpg' },
    { nombre: 'Privacidad 360', precio: 55, nota: 'Privacidad por los 4 lados', color: '#c62828', img: '/img/hidrogel/privacidad-360.jpg' },
];
const tablet: Mica[] = [
    { nombre: 'Tablet 11" HD', precio: 32, nota: 'Transparente · NT-70', color: '#8dc63f', img: '/img/hidrogel/tablet-11-hd.jpg' },
    { nombre: 'Tablet 11" Mate', precio: 32, nota: 'Antirreflejo · NT-71', color: '#b8893a', img: '/img/hidrogel/tablet-11-mate.jpg' },
    { nombre: 'Tablet 13" HD', precio: 45, nota: 'Transparente · HD-25', color: '#8dc63f', img: '/img/hidrogel/tablet-13-hd.jpg' },
    { nombre: 'Tablet 13" Mate', precio: 45, nota: 'Antirreflejo · AG-26', color: '#b8893a', img: '/img/hidrogel/tablet-13-mate.jpg' },
    { nombre: 'Tablet 13" Privacidad HD', precio: 95, nota: 'Privacidad con alta definición', color: '#1b1b1f', img: '/img/hidrogel/tablet-13-privacidad.svg' },
];

// Cortadoras KASR: precio del PDF de KASR + $2,500, ya como precio final
type Cortadora = { modelo: string; corte: string; ancho: number; peso: number; img: string; precio: number };
const cortadoras: Cortadora[] = [
    { modelo: 'KS-X180T', corte: '10"', ancho: 180, peso: 3.5, img: 'ks-x180t', precio: 9520 },
    { modelo: 'KS-11', corte: '12"', ancho: 196, peso: 4.3, img: 'ks-11', precio: 9610 },
    { modelo: 'KS-X5', corte: '15"', ancho: 230, peso: 6.5, img: 'ks-x5', precio: 9880 },
    { modelo: 'KS-F5 Mini', corte: '14"', ancho: 215, peso: 5.8, img: 'ks-f5-mini', precio: 10060 },
    { modelo: 'KS-230', corte: '17"', ancho: 265, peso: 5.7, img: 'ks-230', precio: 10060 },
    { modelo: 'KS-25 Mini', corte: '14"', ancho: 215, peso: 6, img: 'ks-25-mini', precio: 10240 },
    { modelo: 'KS-F5', corte: '17"', ancho: 265, peso: 6.8, img: 'ks-f5', precio: 10240 },
    { modelo: 'KS-08', corte: '14"', ancho: 213, peso: 6.9, img: 'ks-08', precio: 10330 },
    { modelo: 'KS-05', corte: '14"', ancho: 213, peso: 6.3, img: 'ks-05', precio: 10330 },
    { modelo: 'KS-01', corte: '14"', ancho: 213, peso: 6.6, img: 'ks-01', precio: 10330 },
    { modelo: 'KS-X7 Mini', corte: '14"', ancho: 215, peso: 5.6, img: 'ks-x7-mini', precio: 10330 },
    { modelo: 'KS-25', corte: '17"', ancho: 265, peso: 6.7, img: 'ks-25', precio: 10420 },
    { modelo: 'KS-F5 Max', corte: '22"', ancho: 315, peso: 7.2, img: 'ks-f5-max', precio: 10420 },
    { modelo: 'KS-X7', corte: '17"', ancho: 265, peso: 6.6, img: 'ks-x7', precio: 10510 },
    { modelo: 'KS-25 Max', corte: '22"', ancho: 315, peso: 7.6, img: 'ks-25-max', precio: 10600 },
    { modelo: 'KS-08 Max', corte: '21"', ancho: 293, peso: 7.4, img: 'ks-08-max', precio: 10690 },
    { modelo: 'KS-05 Max', corte: '21"', ancho: 293, peso: 7.9, img: 'ks-05-max', precio: 10690 },
    { modelo: 'KS-01 Max', corte: '21"', ancho: 293, peso: 7.7, img: 'ks-01-max', precio: 10690 },
    { modelo: 'KS-X7 Max', corte: '22"', ancho: 315, peso: 7.2, img: 'ks-x7-max', precio: 10690 },
];
const preguntas = [
    ['¿Qué es una mica de hidrogel?', 'Es un protector de pantalla flexible de TPU que cubre toda la pantalla, incluso orillas curvas, y se adhiere sin burbujas. A diferencia del cristal, no se estrella.'],
    ['¿Qué diferencia hay entre HD, mate, Blue Ray y privacidad?', 'HD es transparente y de máxima claridad. Mate quita reflejos y huellas. Blue Ray filtra la luz azul de la pantalla. Privacidad oscurece la pantalla vista de lado; la 360 lo hace por los cuatro lados.'],
    ['¿Me las cortan al tamaño de mi modelo?', 'Sí. Las cortamos con cortadora KASR al tamaño del modelo que elijas, al mismo precio que la lámina sin corte. Solo dinos el modelo de cada celular o tablet.'],
    ['¿Cuándo me lo entregan?', 'Normalmente el mismo día. Si pides por la tarde, por ejemplo a las 3 pm, te lo llevamos ese día; si pides en la noche, por ejemplo a las 7 pm, lo programamos para el día siguiente o, si se puede, te lo llevamos ese mismo día.'],
    ['¿Cuál es el mínimo para la entrega gratis?', 'Desde 50 piezas, o 30 de privacidad, te las llevamos gratis en Pachuca y Mineral de la Reforma.'],
    ['¿Envían a otros estados?', 'Sí, a todo México. A Ciudad de México y Estado de México hay paquetes con envío incluido por Estafeta Express (recoges en sucursal) o UPS Express (a tu domicilio); por ejemplo, 50 micas HD o mate con envío por Estafeta cuestan $750. Al resto del país, como Monterrey o Guadalajara, es el costo de las micas más unos $500 de envío por UPS a domicilio. Escríbenos con tu código postal y te confirmamos. Si estás fuera de México, pregúntanos.'],
    ['¿Puedo recoger mi pedido?', 'Sí, en GAMMA Accesorios para celular, Plaza Tere, Santa Gertrudis, de lunes a viernes de 1:00 a 5:00 pm.'],
    ['¿Tienen para tablet?', 'Sí: láminas para tablet de 11 y 13 pulgadas en HD y mate, y de 13 pulgadas con privacidad HD.'],
    ['¿Cuánto tarda una cortadora y cómo se aparta?', 'Las cortadoras KASR llegan en 2 a 3 semanas a la dirección que nos indiques. Se apartan con un anticipo mínimo del 60% e incluyen un paquete inicial de 50 láminas sin corte.'],
    ['¿Cómo hago mi pedido?', 'Por WhatsApp al 771 868 2542: dinos tipo, cantidad y, si las quieres cortadas, el modelo de cada celular.'],
] as [string, string][];
const paquete = ['15 HD', '15 Mate', '10 Privacidad Mate', '5 Tablet 11" HD', '5 Tablet 11" Mate'];
const pesos = (n: number) => n.toLocaleString('es-MX');

// Envíos por paquetería: precio total con envío incluido a CDMX y Estado de México. Privacidad = mate o HD, mismo precio
type Envio = { nombre: string; entrega: string; ico: string; precios: [string, number][]; nota?: string };
const envios: Envio[] = [
    { nombre: 'Estafeta Express', entrega: 'Recoges en sucursal Estafeta', ico: '🏪', precios: [['50 HD o Mate', 750], ['75 HD o Mate', 900], ['50 Privacidad', 1400], ['75 Privacidad', 2100]] },
    { nombre: 'UPS Express', entrega: 'A tu domicilio exacto', ico: '🏠', precios: [['50 HD o Mate', 850], ['75 HD o Mate', 1000], ['50 Privacidad', 1500], ['75 Privacidad', 2200]], nota: 'Otra cantidad: costo de las micas + $300 de envío.' },
];
// Resto del país: tope estimado con la tarifa UPS Express Saver 2026 de 1 kg en la zona más cara (~$434 + IVA)
const envioPais = 500;

const ofertas = [...celular, ...tablet].map((m) => ({
    '@type': 'Offer',
    priceCurrency: 'MXN',
    price: m.precio,
    itemOffered: { '@type': 'Product', name: `Mica de hidrogel ${m.nombre}`, category: 'Protector de pantalla de hidrogel' },
}));
const schema = {
    '@context': 'https://schema.org',
    '@graph': [
        {
            '@type': 'LocalBusiness',
            '@id': 'https://celinki.com/#tienda',
            name: 'Celinki · Micas de hidrogel',
            url: 'https://celinki.com/',
            logo: 'https://celinki.com/favicon.svg',
            image: 'https://celinki.com/img/hidrogel/maquina.jpg',
            description: 'Proveedor de micas de hidrogel KASR en Pachuca y Mineral de la Reforma: cortadas al tamaño del modelo que elijas o en lámina sin corte, a mayoreo, con entrega gratis. Punto de recolección en Plaza Tere, Santa Gertrudis.',
            telephone: '+52 771 868 2542',
            priceRange: '$12 - $10,690 MXN',
            currenciesAccepted: 'MXN',
            address: {
                '@type': 'PostalAddress',
                streetAddress: 'Plaza Tere, A El Huixmí',
                addressLocality: 'Santa Gertrudis',
                addressRegion: 'Hidalgo',
                postalCode: '42111',
                addressCountry: 'MX',
            },
            geo: { '@type': 'GeoCoordinates', latitude: 20.0867391, longitude: -98.8078223 },
            openingHoursSpecification: [
                { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '00:00', closes: '23:59' },
            ],
            areaServed: [
                { '@type': 'City', name: 'Pachuca de Soto' },
                { '@type': 'City', name: 'Mineral de la Reforma' },
                { '@type': 'Country', name: 'México' },
            ],
            hasOfferCatalog: {
                '@type': 'OfferCatalog',
                name: 'Micas de hidrogel KASR',
                itemListElement: ofertas,
            },
        },
        {
            '@type': 'FAQPage',
            '@id': 'https://celinki.com/#preguntas',
            mainEntity: preguntas.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
        },
        {
            '@type': 'WebSite',
            '@id': 'https://celinki.com/#sitio',
            url: 'https://celinki.com/',
            name: 'Celinki',
            inLanguage: 'es-MX',
            publisher: { '@id': 'https://celinki.com/#tienda' },
        },
    ],
};
---

<!doctype html>
<html lang="es-MX">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>Micas de hidrogel cortadas a tu modelo · Pachuca y Mineral de la Reforma | Celinki</title>
        <meta
            name="description"
            content="Micas de hidrogel KASR cortadas al tamaño del modelo que elijas o en lámina sin corte, a mayoreo: HD, mate, Blue Ray y privacidad, para celular y tablet. Entrega gratis en Pachuca y Mineral de la Reforma desde 50 piezas. Cortadoras de hidrogel KASR con 50 láminas de regalo."
        />
        <link rel="canonical" href="https://celinki.com/" />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <script is:inline>document.documentElement.classList.add('js');</script>
        <meta name="theme-color" content="#8dc63f" />
        <meta property="og:type" content="website" />
        <meta property="og:url" content="https://celinki.com/" />
        <meta property="og:locale" content="es_MX" />
        <meta property="og:site_name" content="Celinki" />
        <meta property="og:description" content="Micas de hidrogel cortadas al tamaño del modelo que elijas o en lámina sin corte. Entrega gratis en Pachuca y Mineral de la Reforma." />
        <meta name="twitter:card" content="summary_large_image" />
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
        <meta property="og:title" content="Celinki · Micas de hidrogel con entrega gratis en Pachuca y Mineral de la Reforma" />
        <meta property="og:image" content="https://celinki.com/img/compartir.jpg" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;800&display=swap" rel="stylesheet" />
    </head>
    <body>
        <header class="barra">
            <div class="wrap barra-in">
                <a class="logo" href="/" aria-label="Celinki, inicio"><img src="/favicon.svg" alt="" width="28" height="28" /><span>celinki</span></a>
                <nav class="menu">
                    <a href="#celular">Micas</a>
                    <a href="#como-pedir">Cómo pedir</a>
                    <a href="#entregas">Entregas</a>
                    <a href="#envios">Envíos</a>
                    <a href="#cortadoras">Cortadoras</a>
                    <a href="#visitanos">Tienda</a>
                </nav>
                <a class="btn btn-wa btn-chico" href={hidrogelWa()} target="_blank" rel="noopener">WhatsApp</a>
            </div>
        </header>

        <main id="hidrogel" class="kasr">
            <div class="wrap">
                <div class="k-encabezado">
                    <div>
                        <h1>Micas de hidrogel</h1>
                        <p class="hero-sub">Cortadas al tamaño del modelo que elijas o en lámina sin corte. <b>Mismo precio.</b></p>
                        <div id="entregas" class="hero-entrega">
                            <span class="he-ico">🚚</span>
                            <div>
                                <b>Entrega gratis</b>
                                <p class="he-lugares"><span><img src="/img/iconos/pachuca-reloj.svg" alt="" /> Pachuca</span> <span><img src="/img/iconos/mineral-castillete.svg" alt="" /> Mineral de la Reforma</span></p>
                                <small>Normalmente el mismo día · desde 50 piezas o 30 de privacidad</small>
                            </div>
                        </div>
                        <a class="hero-envio" href="#envios">
                            <span class="he-ico">📦</span>
                            <div>
                                <b>Envíos a todo México</b>
                                <small>CDMX y Edomex desde $750 con envío incluido · Monterrey, Guadalajara y más. <span class="he-cotiza">Ver precios →</span></small>
                            </div>
                        </a>
                        <div class="hero-botones">
                            <a class="btn btn-negro" href="#celular">Ver micas</a>
                            <a class="btn btn-borde" href="#como-pedir">Cómo pedir</a>
                        </div>
                    </div>
                    <img src="/img/hidrogel/maquina.jpg" alt="Cortadora KASR cortando micas de hidrogel al tamaño de cada modelo" width="1000" height="796" fetchpriority="high" class="hero-img" />
                </div>


                <h3 class="k-flechas" id="celular">Celular</h3>
                <ul class="k-grid">
                    {celular.map((m) => (
                        <li class="k-card" style={`--etq:${m.color}`}>
                            <div class="k-foto">
                                {m.img ? <img src={m.img} alt={`Mica de hidrogel ${m.nombre}`} loading="lazy" /> : <span class="k-sinfoto">{m.nombre}</span>}
                            </div>
                            <div class="k-info">
                                <h4>{m.nombre}</h4>
                                <p>{m.nota}</p>
                                <p class="k-precio">${m.precio}<small> por lámina</small></p>
                            </div>
                        </li>
                    ))}
                </ul>

                <h3 class="k-flechas">Tablet</h3>
                <ul class="k-grid">
                    {tablet.map((m) => (
                        <li class="k-card" style={`--etq:${m.color}`}>
                            <div class="k-foto">
                                {m.img ? <img src={m.img} alt={`Mica de hidrogel ${m.nombre}`} loading="lazy" /> : <span class="k-sinfoto">{m.nombre}</span>}
                            </div>
                            <div class="k-info">
                                <h4>{m.nombre}</h4>
                                <p>{m.nota}</p>
                                <p class="k-precio">${m.precio}<small> por lámina</small></p>
                            </div>
                        </li>
                    ))}
                </ul>

                <h3 class="k-flechas" id="como-pedir">Cómo pedir</h3>
                <ol class="pasos">
                    <li>
                        <img src="/img/pasos/1-whatsapp.svg" alt="Pedido por WhatsApp" loading="lazy" />
                        <span class="paso-n">1</span>
                        <b>Escríbenos por WhatsApp</b>
                        <span>Tipo y cantidad. Si las quieres cortadas al tamaño de tu modelo, dinos el modelo de cada celular.</span>
                    </li>
                    <li>
                        <img src="/img/pasos/2-cortada-o-lamina.svg" alt="Cortada al tamaño de tu modelo o lámina sin corte, mismo precio" loading="lazy" />
                        <span class="paso-n">2</span>
                        <b>¿Cortada o lámina sin corte?</b>
                        <span>Cortada al tamaño del modelo que elijas o lámina sin corte. <strong>Mismo precio.</strong></span>
                    </li>
                    <li>
                        <img src="/img/pasos/3-cortamos.svg" alt="Cortadora KASR cortando la mica" loading="lazy" />
                        <span class="paso-n">3</span>
                        <b>La cortamos al tamaño de tu modelo</b>
                        <span>Con cortadora KASR y miles de modelos de celular y tablet.</span>
                    </li>
                    <li>
                        <img src="/img/pasos/4-entrega.svg" alt="Entrega gratis en Pachuca y Mineral de la Reforma" loading="lazy" />
                        <span class="paso-n">4</span>
                        <b>Te la llevamos gratis</b>
                        <span>
                            <img class="lugar" src="/img/iconos/pachuca-reloj.svg" alt="" /> Pachuca ·
                            <img class="lugar" src="/img/iconos/mineral-castillete.svg" alt="" /> Mineral de la Reforma,
                            desde 50 piezas o 30 de privacidad. O recoge en GAMMA. Al resto de México, <a href="#envios">por paquetería</a>.
                        </span>
                    </li>
                </ol>
                <div class="pasos-cta">
                    <a class="btn btn-wa" href={wa(telHidrogel, 'Hola Celinki, quiero micas de hidrogel cortadas al tamaño de mis modelos. Modelos y cantidades:')} target="_blank" rel="noopener">✂ Pedir cortadas a mi modelo</a>
                    <a class="btn btn-borde" href={wa(telHidrogel, 'Hola Celinki, quiero láminas de hidrogel sin corte a mayoreo:')} target="_blank" rel="noopener">Pedir lámina sin corte</a>
                </div>

                <h3 class="k-flechas" id="envios">Envíos a todo México</h3>
                <p class="envios-sub"><b>Ciudad de México y Estado de México:</b> precio total, micas y envío incluidos.</p>
                <div class="envios">
                    {envios.map((e) => (
                        <div class="envio">
                            <h4>{e.nombre}</h4>
                            <p class="envio-entrega"><span aria-hidden="true">{e.ico}</span>{e.entrega}</p>
                            <ul>
                                {e.precios.map(([q, p]) => (
                                    <li><span>{q}</span><b>${pesos(p)}</b></li>
                                ))}
                            </ul>
                            {e.nota && <p class="k-gris">{e.nota}</p>}
                        </div>
                    ))}
                </div>
                <div class="envio-pais">
                    <span class="he-ico" aria-hidden="true">🇲🇽</span>
                    <div>
                        <b>Resto del país: Monterrey, Guadalajara, Querétaro, Puebla…</b>
                        <p>Costo de las micas <b>+ ${envioPais} de envío aprox.</b> por UPS a tu domicilio. Ejemplo: 50 HD o mate = <b>${pesos(50 * 12 + envioPais)}</b>. ¿Fuera de México? Pregúntanos.</p>
                    </div>
                </div>
                <div class="pasos-cta">
                    <a class="btn btn-wa" href={wa(telHidrogel, 'Hola Celinki, quiero cotizar micas de hidrogel con envío. Ciudad y código postal:')} target="_blank" rel="noopener">📦 Cotizar envío por WhatsApp</a>
                </div>

                <h3 class="k-flechas" id="cortadoras">Cortadoras de hidrogel KASR</h3>
                <div class="k-paquete">
                    <p><b>Arma tu propio negocio de micas.</b> Cada cortadora incluye un <b>paquete inicial de 50 láminas sin corte</b>:</p>
                    <ul>{paquete.map((x) => <li>{x}</li>)}</ul>
                    <ul class="condiciones">
                        <li><span>🚚</span><b>Entrega en 2 a 3 semanas</b> en la dirección que nos indiques</li>
                        <li><span>💳</span><b>Anticipo mínimo del 60%</b> para apartar tu cortadora</li>
                    </ul>
                    <p class="k-gris">Con espátulas, tapete, cuchillas, cable y eliminador. Corta micas para celular, tablet, laptop, smartwatch, cámara, consola y más. Conexión WiFi/Bluetooth y modelos en la nube.</p>
                    <a class="btn btn-wa" href={wa(telHidrogel, 'Hola Celinki, quiero cotizar una cortadora KASR. Modelo:')} target="_blank" rel="noopener">Cotizar cortadora por WhatsApp</a>
                </div>
                <ul class="k-grid cortadoras-lista">
                    {cortadoras.map((c) => (
                        <li class="k-card" style="--etq:#8dc63f">
                            <div class="k-foto k-foto-ancha"><img src={`/img/cortadoras/${c.img}.jpg`} alt={`Cortadora de hidrogel KASR ${c.modelo}`} loading="lazy" /></div>
                            <div class="k-info">
                                <h4>{c.modelo} <span class="k-corte">Corte {c.corte}</span></h4>
                                <p>Ancho de corte {c.ancho} mm · {c.peso} kg</p>
                                <p>+ 50 láminas sin corte de regalo</p>
                                <p class="k-precio">${pesos(c.precio)}<small> precio final</small></p>
                            </div>
                        </li>
                    ))}
                </ul>
                <button type="button" class="ver-todas btn btn-borde" aria-expanded="false">Ver todas las cortadoras ({cortadoras.length})</button>


                <h3 class="k-flechas" id="preguntas">Preguntas frecuentes</h3>
                <div class="faq">
                    {preguntas.map(([q, a]) => (
                        <details>
                            <summary>{q}</summary>
                            <p>{a}</p>
                        </details>
                    ))}
                </div>

                <h3 class="k-flechas" id="visitanos">Recoge en tienda</h3>
                <div class="k-card visita" style="--etq:#8dc63f">
                    <div class="visita-info">
                        <h4>GAMMA Accesorios para celular</h4>
